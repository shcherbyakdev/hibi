# Copy to .env.local. `npm run setup` fills blanks from the local Supabase
# stack (supabase/config.toml, API on :54411) and never overwrites a value.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local default: postgresql://postgres:postgres@127.0.0.1:54412/postgres
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3100

# Production only (set in Vercel, never locally or in CI): turns on the
# checks in src/env-schema.ts — the app refuses to build/start unless
# NEXT_PUBLIC_APP_URL is the public https URL and Supabase is not local.
# APP_ENV=production
